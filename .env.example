# Copy this file to .env. Use the credentials created in the host MySQL server.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=cmsdb
DB_USER=cmsdbuser
DB_PASSWORD=replace_with_your_mysql_password
DB_SSL_MODE=Preferred
JWT_KEY=replace_with_at_least_32_random_characters
ASPNETCORE_ENVIRONMENT=Production
DOMAIN=pulseleef.com
